nded border border-amber-500/20">
                      CORE v1.0 lamely negeneruje. Přesné elements[] dodá samostatný Louver modul.
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        )}

        {/* TAB 3: ŘEZNÝ LIST */}
        {activeTab === 'cuttingList' && (
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 flex flex-col gap-4">
            <div className="flex justify-between items-center print:hidden">
              <h3 className="text-base font-semibold text-white flex items-center gap-2">
                <Printer className="w-5 h-5 text-orange-500" /> Výrobní řezný list (čteno z elements[])
              </h3>
              <div className="flex items-center gap-3">
                <span className="text-xs font-mono text-slate-400 bg-slate-950 px-3 py-1 rounded border border-slate-800">
                  Celková hmotnost: {cuttingListAndFinancials.totalWeightKg !== null ? `${cuttingListAndFinancials.totalWeightKg} kg` : 'Hmotnost profilu není zadána.'}
                </span>
                <button 
                  onClick={handlePrint}
                  className="bg-orange-600 hover:bg-orange-500 text-white text-xs font-semibold py-2 px-4 rounded-lg flex items-center gap-1.5 shadow-md"
                >
                  <Printer className="w-3.5 h-3.5" /> Tisk / PDF
                </button>
              </div>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs font-mono">
                <thead className="bg-slate-950 text-slate-400 border-b border-slate-800">
                  <tr>
                    <th className="p-3">ID</th>
                    <th className="p-3">Role / Název</th>
                    <th className="p-3">Profil</th>
                    <th className="p-3">Délka (mm)</th>
                    <th className="p-3">Hmotnost (kg)</th>
                    <th className="p-3">Cena profilu</th>
                    <th className="p-3">Cena dílu</th>
                    <th className="p-3">Zdroj profilu</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800/60 text-slate-300">
                  {cuttingListAndFinancials.analyzedElements.map(el => (
                    <tr key={el.id} className="hover:bg-slate-950/50">
                      <td className="p-3 text-orange-400 font-bold">{el.id}</td>
                      <td className="p-3">
                        <div className="font-semibold text-white">{el.name}</div>
                        <div className="text-[10px] text-emerald-400">{el.role}</div>
                      </td>
                      <td className="p-3">{el.profile.name}</td>
                      <td className="p-3">{el.lengthMm !== null ? `${el.lengthMm} mm` : <span className="text-red-400">Neplatná geometrie</span>}{el.lengthMismatch && <div className="text-[9px] text-amber-400">uložená délka byla odlišná; použita start/end</div>}</td>
                      <td className="p-3">
                        {el.calculatedWeight !== null ? `${el.calculatedWeight} kg` : <span className="text-amber-400 text-[10px]">Hmotnost profilu není zadána.</span>}
                      </td>
                      <td className="p-3 text-[10px]">
                        {el.profile.pricePerMeter != null ? `${el.profile.pricePerMeter} Kč/m` :
                          el.profile.pricePerKg != null ? `${el.profile.pricePerKg} Kč/kg` :
                          el.effectivePricePerKg != null ? `${el.effectivePricePerKg} Kč/kg (fallback)` :
                          <span className="text-amber-400">Cena nezadána</span>}
                      </td>
                      <td className="p-3">{el.calculatedCost !== null ? `${el.calculatedCost} Kč` : <span className="text-amber-400 text-[10px]">Nelze stanovit</span>}</td>
                      <td className="p-3 text-[10px] text-slate-400">{el.profile.weightSource || 'unknown'} / {el.effectivePriceSource || 'unknown'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* TAB 4: KALKULACE */}
        {activeTab === 'pricing' && (
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 flex flex-col gap-6 max-w-2xl mx-auto w-full">
            <h3 className="text-base font-semibold text-white flex items-center gap-2">
              <DollarSign className="w-5 h-5 text-orange-500" /> Cenová kalkulace (Strict Schema)
            </h3>

            <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex flex-col gap-3 text-sm print:hidden">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pb-3 border-b border-slate-900">
                <label className="text-xs text-slate-400">
                  Fallback cena materiálu (Kč/kg)
                  <input
                    type="number"
                    min="0"
                    step="0.01"
                    value={construction.financials?.materialPricing?.pricePerKg ?? ''}
                    onChange={(e) => handleMaterialPriceChange(e.target.value)}
                    placeholder="Nezadána"
                    className="mt-1 w-full bg-slate-900 border border-slate-700 rounded p-2 text-slate-100 font-mono"
                  />
                </label>
                <label className="text-xs text-slate-400">
                  Zdroj ceny / poznámka
                  <input
                    type="text"
                    value={construction.financials?.materialPricing?.sourceNote ?? ''}
                    onChange={(e) => handleMaterialPriceSourceNoteChange(e.target.value)}
                    placeholder="např. dodavatel / faktura / ceník"
                    className="mt-1 w-full bg-slate-900 border border-slate-700 rounded p-2 text-slate-100"
                  />
                </label>
              </div>
              <div className="text-[11px] text-slate-500">
                Zdroj hodnoty: <span className="font-mono text-slate-300">{construction.financials?.materialPricing?.source || 'unknown'}</span>. Použije se jen tam, kde profil nemá vlastní cenu/m ani vlastní cenu/kg. Priorita je vždy cena/m → kg/m × cena/kg.
              </div>
            </div>

            <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex flex-col gap-3 text-sm">
              <div className="flex justify-between py-2 border-b border-slate-900">
                <span className="text-slate-400">Materiálové náklady:</span>
                <span className="font-mono text-slate-100">
                  {cuttingListAndFinancials.materialCost !== null ? `${cuttingListAndFinancials.materialCost} Kč` : <span className="text-amber-400 text-xs font-bold">Neúplné (některý profil nemá cenu/m ani kombinaci kg/m × Kč/kg)</span>}
                </span>
              </div>
              <div className="flex justify-between py-2 border-b border-slate-900">
                <span className="text-slate-400">Práce ({construction.financials.laborHours} hod × {construction.financials.hourlyRate} Kč/h):</span>
                <span className="font-mono text-slate-100">{cuttingListAndFinancials.laborTotal} Kč</span>
              </div>
              <div className="flex justify-between py-2 border-b border-slate-900">
                <span className="text-slate-400">Kování a doplňky:</span>
                <span className="font-mono text-slate-100">{cuttingListAndFinancials.hardwareCost} Kč</span>
              </div>
              <div className="flex justify-between py-2 border-b border-slate-900">
                <span className="text-slate-400">Marže ({construction.financials.marginPercent}%):</span>
                <span className="font-mono text-slate-100">{cuttingListAndFinancials.materialCost === null ? 'Nelze spočítat' : 'Automaticky počítána'}</span>
              </div>
              <div className="flex justify-between py-3 text-base font-bold text-orange-400">
                <span>Celková výsledná cena:</span>
                <span className="font-mono">
                  {cuttingListAndFinancials.finalPrice !== null ? `${cuttingListAndFinancials.finalPrice} Kč bez DPH` : <span className="text-amber-400 text-sm">Nelze stanovit (některému profilu chybí cenová cesta)</span>}
                </span>
              </div>
            </div>
            {cuttingListAndFinancials.hasInvalidGeometry && (
              <p className="text-xs text-red-400 bg-red-950/20 p-3 rounded border border-red-500/30">Neplatná geometrie prvku. Cena není stanovena, dokud není platný start/end.</p>
            )}
            {cuttingListAndFinancials.hasUnverifiedWeight && (
              <p className="text-xs text-amber-400 bg-amber-950/20 p-3 rounded border border-amber-500/30">
                Upozornění: Některé profily 